            </intent-filter>
        </activity>
        <activity android:name=".ToolsActivity" android:exported="false" />
        <activity android:name=".PhotoActivity" android:exported="false" />
        <activity android:name=".MaintenanceActivity" android:exported="false" />
        <receiver android:name=".WifiBootReceiver" android:exported="false">
